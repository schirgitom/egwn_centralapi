{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=egwncentral;Username=root;Password=root"
  },
  "Jwt": {
    "Issuer": "egwncentral-api",
    "Audience": "egwncentral-clients",
    "SigningKey": "replace-this-with-a-long-32-char-min-secret",
    "ExpirationMinutes": 60
  },
  "Auth": {
    "Username": "admin",
    "Password": "admin-change-me"
  },
  "Consul": {
    "Enabled": false,
    "Address": "http://localhost:8500",
    "Key": "egwncentral/appsettings"
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
